# Normal mode never falls back to synthetic data when credentials are missing.
SCHOLARFLOW_DEMO=false
SCHOLARFLOW_DATA_DIR=data/scholarflow
SCHOLARFLOW_MODEL=openai:gpt-4o-mini
SCHOLARFLOW_MAX_INCLUDED_PAPERS=20
SCHOLARFLOW_READER_CONCURRENCY=2
SCHOLARFLOW_MAX_MODEL_CALLS=100

# Server-side credentials only. OpenAI-compatible endpoints use OPENAI_BASE_URL.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://your-compatible-provider.example/v1
# Optional: if a local proxy disconnects long DashScope requests and direct access works,
# append dashscope.aliyuncs.com to your existing NO_PROXY in the API/worker environment.
# NO_PROXY=localhost,127.0.0.1,dashscope.aliyuncs.com
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=

# Optional legacy general research mode
TAVILY_API_KEY=
